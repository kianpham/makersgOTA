# Sao chép thành .env (hoặc export trực tiếp). Tất cả có default chạy local được ngay.
XZ_SECRET_KEY=dev-insecure-change-me      # ĐỔI ở production
XZ_PUBLIC_HOST=127.0.0.1                   # địa chỉ thiết bị truy cập được (LAN IP khi test board thật)
XZ_PUBLIC_PORT=8000
XZ_WS_PATH=/api/v1/ws
XZ_DB_PATH=./data/devices.db
XZ_FIRMWARE_DIR=./data/firmware
XZ_TOKEN_TTL_S=86400
XZ_TZ_OFFSET_MIN=420                       # +07:00
XZ_REQUIRE_AUTH=1                          # 0 để tắt verify token ws (chỉ khi debug)
XZ_ACTIVATION_TTL_MS=300000
XZ_ADMIN_USER=admin                        # tài khoản console quản lý — ĐỔI ở production
XZ_ADMIN_PASSWORD=admin                    # mật khẩu admin — ĐỔI ở production
